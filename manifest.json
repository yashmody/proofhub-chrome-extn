{
  "manifest_version": 3,
  "name": "ProofHub Quick Task",
  "description": "Quickly add tasks to ProofHub with email integration.",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.proofhub.com/*"
  ]
}
